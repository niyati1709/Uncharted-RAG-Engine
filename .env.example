# ==========================================
# DevDocs AI - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your actual credentials:
#   Copy-Item .env.example .env

# --- MongoDB Atlas Configuration ---
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=DevDocsAI
MONGODB_DATABASE=devdocs_ai
MONGODB_DOCUMENTS_COLLECTION=documents
MONGODB_CHUNKS_COLLECTION=chunks
MONGODB_VECTOR_INDEX_NAME=chunks_vector_index

# --- Embedding Configuration (Coordinated with Member 2) ---
# Default placeholder; will be finalized based on Member 2's model:
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- LLM API Configuration ---
# Groq API key for fast inference (free developer tier available at console.groq.com):
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# --- Retrieval Configuration ---
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35

